{
  "_doc": "docs/layers.md. Each crate's layer (engine, platform, atlas, or tool for dev tools) and the layers each may depend on: the Atlas layer uses only the platform, so it can build from its own repository. 'allowed' lists the exceptions left to move: entries only go away.",
  "may_depend": {
    "engine": ["engine"],
    "platform": ["engine", "platform"],
    "atlas": ["platform", "atlas"]
  },
  "workspaces": [
    "Cargo.toml",
    "launcher/Cargo.toml",
    "crates/atlas-telemetry-server/Cargo.toml",
    "crates/atlas-mod-registry/Cargo.toml"
  ],
  "crates": {
    "atlas-assets": "engine",
    "atlas-bench": "engine",
    "atlas-client": "engine",
    "atlas-client-core": "engine",
    "atlas-client-input": "engine",
    "atlas-client-lib": "engine",
    "atlas-client-render": "engine",
    "atlas-command": "engine",
    "atlas-core": "engine",
    "atlas-hooks": "engine",
    "atlas-items": "engine",
    "atlas-narrator": "engine",
    "atlas-perf-format": "engine",
    "atlas-prepare": "engine",
    "atlas-protocol": "engine",
    "atlas-server-files": "engine",
    "atlas-system": "engine",
    "atlas-threads": "engine",
    "atlas-world": "engine",

    "cargo-atlas-mod": "platform",
    "atlas-anticheat": "platform",
    "atlas-chat-filter": "platform",
    "atlas-dualsense": "platform",
    "atlas-game": "platform",
    "atlas-hdr": "platform",
    "atlas-mcp": "platform",
    "atlas-mod-api-gen": "platform",
    "atlas-mod-deps": "platform",
    "atlas-mods": "platform",
    "atlas-optifine": "platform",
    "atlas-platform": "platform",
    "atlas-polytone": "platform",
    "atlas-port-pack": "platform",
    "atlas-shader-api": "platform",
    "atlas-shaders": "platform",
    "atlas-theme": "platform",

    "atlas-addresses": "atlas",
    "atlas-cosmetics": "atlas",
    "atlas-discord": "atlas",
    "atlas-friends": "atlas",
    "atlas-heartbeat": "atlas",
    "atlas-launcher": "atlas",
    "atlas-mod-registry": "atlas",
    "atlas-official": "atlas",
    "atlas-official-servers": "atlas",
    "atlas-perf-share": "atlas",
    "atlas-relay": "atlas",
    "atlas-release-sign": "atlas",
    "atlas-server": "atlas",
    "atlas-telemetry": "atlas",
    "atlas-telemetry-server": "atlas",

    "atlas-bots": "tool",
    "atlas-perf": "tool",
    "atlas-mod-api-gen-tests": "tool",
    "xtask": "tool"
  },
  "portable": {
    "_doc": "docs/layers.md#engine: vanilla's rules and data with no desktop in them, which a port builds on. They depend only on each other, and never on a forbidden library.",
    "crates": [
      "atlas-assets",
      "atlas-client-core",
      "atlas-command",
      "atlas-core",
      "atlas-items",
      "atlas-protocol",
      "atlas-threads",
      "atlas-world"
    ],
    "forbidden": ["arboard", "cpal", "gilrs", "ureq", "wgpu", "winit"]
  },
  "allowed": [
    "atlas-client -> atlas-anticheat",
    "atlas-client -> atlas-chat-filter",
    "atlas-client -> atlas-cosmetics",
    "atlas-client -> atlas-dualsense",
    "atlas-client -> atlas-friends",
    "atlas-client -> atlas-hdr",
    "atlas-client -> atlas-mod-api-gen",
    "atlas-client -> atlas-mods",
    "atlas-client -> atlas-optifine",
    "atlas-client -> atlas-shader-api",
    "atlas-client -> atlas-shaders",
    "atlas-client -> atlas-telemetry",
    "atlas-client -> atlas-theme",
    "atlas-client-lib -> atlas-anticheat",
    "atlas-client-lib -> atlas-hdr",
    "atlas-client-lib -> atlas-mcp",
    "atlas-client-lib -> atlas-mods",
    "atlas-client-lib -> atlas-optifine",
    "atlas-client-lib -> atlas-shader-api",
    "atlas-client-lib -> atlas-shaders",
    "atlas-client-lib -> atlas-telemetry",
    "atlas-client-render -> atlas-hdr",
    "atlas-client-render -> atlas-optifine",
    "atlas-client-render -> atlas-polytone",
    "atlas-client-render -> atlas-shader-api",
    "atlas-client-render -> atlas-shaders"
  ]
}
